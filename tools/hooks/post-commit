#!/bin/sh
# Kilo: 配置提交后部署提醒（防部署漂移复发）
# 根因案例：v6.2 提交(9cd92cc)后漏跑 install.ps1，全局目录长期运行旧代际配置，
# 导致会话未按项目源设计的编排工作流执行（failure_db: fail-20260727-partial-migration，已复发 2 次）。
#
# 使用方式：
#   cp tools/hooks/post-commit .git/hooks/post-commit
#   chmod +x .git/hooks/post-commit
# 判定方式：**白名单反选**（只排除确定不部署的根文件），而非正向列举部署目录。
# 旧写法 `^(agent/|lifecycle/|\.kilo/|kilo\.json|AGENTS\.md|docs/model-registry\.md)` 是黑名单，
# 漏掉了 scripts/ ——而 install 会把 scripts/ 全量部署，且 lifecycle-doctor 门禁与运行时脚本
# 正是在部署副本里执行的（doctor --root 实测跑的就是这份）。改完脚本提交不提醒 = 全局继续跑旧
# 门禁，恰好是本 hook 立项要防的那类事故。黑名单还会随每次新增顶层目录继续漏；反选后新增内容
# 默认落入「提醒」侧，最坏只是多提醒一次，不会假绿。
# 排除项事实源 = install.ps1 $RootOnlyExclude + .gitignore 根条目；这里只列不部署项，
# 漂移后果是「多提醒」而非「漏提醒」，故可接受字面维护。
if git diff-tree --no-commit-id --name-only -r HEAD \
  | grep -vE '^(install\.ps1$|install\.sh$|README\.md$|LICENSE$|\.gitignore$|\.editorconfig$)' \
  | grep -q .; then
  echo ""
  echo "[kilo][DEPLOY-REMINDER] 配置变更已提交，全局目录 (~/.config/kilo) 不会自动同步。"
  echo "[kilo][DEPLOY-REMINDER] 请运行: pwsh -File install.ps1   （部署后重启 Kilo 生效）"
  echo "[kilo][DEPLOY-REMINDER] 漏跑会导致全局运行旧代际配置（见 failure_db: fail-20260727-partial-migration）。"
fi
exit 0
