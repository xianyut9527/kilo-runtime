# kilo_config 仓库忽略规则

# 依赖目录（所有子包共用）
node_modules/

# 包管理文件（仓库根与各子包；install 脚本不依赖它们，Git 层面忽略以防误提交）
package.json
package-lock.json
pnpm-lock.yaml
bun.lock
yarn.lock

# ⚠️ 例外：provider/hx-failover 是自研包的源码载体，其 package.json 与 lock 必须入库
# （构建与依赖版本可复现）。node_modules/ 仍被上面的规则忽略。
!provider/hx-failover/package.json
!provider/hx-failover/package-lock.json

# 运行时生成文件（个人数据，不应在团队间共享）
**/.kilo/agent-manager.json
.kilo_tmp/
.worktrees/

# IDE / MCP 运行时产物
.playwright-mcp/
.mcp-tmp/

# 操作系统 / 编辑器临时文件
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
__pycache__/
.pytest_cache/
.ruff_cache/

# 通用备份 / 临时 / 对比文件（防 LLM 修复流程产生的中间产物污染仓库）
*.bak
*.bak2
*.orig
*.old
*_before.*
*_after.*
*_old*
*.diff
*.patch
*.b64
scripts/_*.mjs
temp_*

# 下发器产生的目标目录备份（默认在 ~/.config/ 下，若改为仓内目标则忽略）
kilo.backup-*.tar
kilo.json.bak.*

# LLM 排查/调试脚手架产物（曾误提交，此模式覆盖防回归）
*.rec
render.tmp.json
render-check.*
find-ctrl.*
find-sub.*
check.cjs
