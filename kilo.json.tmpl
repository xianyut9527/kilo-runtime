{
  // ══════════════════════════════════════════════════════════════════
  // KiloCode 全局配置（SSOT 模板）
  // 仓库里这份带注释；install 部署时会剥离所有「行首 //」注释行，
  // 现网 ~/.config/kilo/kilo.json 保持纯 JSON（Kilo 拒绝自定义键，
  // 注释键 "//" 会让整份配置失效 —— 所以只能在模板层注释）。
  // 改完跑 ./install.ps1（或 ./install.sh）部署，重启 Kilo 生效。
  // ══════════════════════════════════════════════════════════════════
  "$schema": "https://app.kilo.ai/config.json",

  // ── 模型总开关 ──────────────────────────────────────────────────
  // 主力执行模型（default_agent=code 绑定它）。glm-5.3-flash：实测最快档，支持图像输入
  "model": "hx/glm-5.3-flash",
  // 轻任务模型：起会话标题/摘要等后台活，用最便宜的 minimax
  "small_model": "hx/minimax-m3",
  // 子代理（task 工具派活）默认模型，深度任务时会按 INSTRUCTIONS 升级到 general
  "subagent_model": "hx/glm-5.3-flash",
  // 子代理最大嵌套深度（防递归失控）：子→孙 两层封顶
  "subagent_depth": 2,
  // 无显式指定 agent 时的默认入口
  "default_agent": "code",

  // ── 基础行为 ────────────────────────────────────────────────────
  // 会话级快照：每次编辑前存档，可回滚（checkpoint 功能）。安全网，性能专项验证后保持开启。
  "snapshot": true,
  // 扩展自动更新（更新后建议跑 ./install.sh --check 确认渲染一致）
  "autoupdate": true,
  // 会话分享彻底关闭（不出网）
  "share": "disabled",
  // 隐私模式：遥测不上报
  "privacy_mode": true,
  // 允许模型用网络搜索
  "web_search": true,
  // 保存后自动跑 formatter（prettier 等）。性能专项验证后保持开启（关它换不来多少速度，还会漂移代码风格）。
  "formatter": true,
  // LSP 代码智能（跳转/补全/诊断），配合 permission.lsp=allow
  "lsp": true,
  // 远程控制：常驻云端中继连接，会话事件多一条转发通道（49f8ed9/f3caadd 与模型切换同期引入的
  // 变慢嫌疑项）。不用手机端盯任务就关；需要时 /remote 临时开
  "remote_control": false,

  // ── 每会话注入的策略文件（认知中心/风险分级/一次性交付/硬约束）──
  // __KILO_HOME__ 由 installer 替换为本机家目录（Kilo 不展开 ~，必须绝对路径）
  // GLOBAL-NOTES.md 是全自动生长的全局经验层：agent 直接追加（不进下发清单，
  // 属运行时状态非配置；install 不清理清单外文件），/evolve 定期修剪并升格成熟条目
  "instructions": [
    "__KILO_HOME__/.config/kilo/INSTRUCTIONS.md",
    "__KILO_HOME__/.config/kilo/GLOBAL-NOTES.md"
  ],
  // 技能目录：agent 可按需加载领域知识（技能增删无需改配置）
  "skills": {
    "paths": [
      "__KILO_HOME__/.agents/skills"
    ]
  },

  // ── 智能体路由（前 5 个是内置 agent 的模型覆盖，verify 是自定义）──
  // code         默认执行者：写代码/跑命令，glm-5.3-flash（实测最快档）。
  //              ⚠️ 性能红线：49f8ed9 曾把 code 换成 deepseek-v4.1-flash，日常 95% 任务走 code
  //              agent → 体感全面变慢（git 49f8ed9 即"快→慢"分界，同期还开了 remote_control）。
  //              换主力模型必须单变量切换并实测对比，不得随其他改动捎带调整。
  // plan         规划模式：出方案不动手，用 kimi 换个视角思考
  // general      深度子任务：难啃的实现/分析，用 glm-5.2 大杯
  // explore      探索代理（subagent）：只读侦察，用最便宜模型扫代码
  // orchestrator 多代理编排：拆解任务分派子代理
  // verify       自定义复核代理（subagent）：异源模型 kimi 复核 glm 的产出
  //              —— 不同厂商交叉验证，只读不许改（edit/bash写通道均 deny）
  // variant 默认不设：agent 级默认 high/max 会让每轮工具调用都先深度思考，
  // 多轮任务累积延迟明显（实测体感"非常慢"）。需要时在模型选择器手动切换
  // 思考强度（模型级 variants 已注册 low/medium/high/max）。
  "agent": {
    "code": {
      "model": "hx/glm-5.3-flash"
    },
    "plan": {
      "model": "hx/kimi-k2.6"
    },
    "general": {
      "model": "hx/glm-5.2"
    },
    "explore": {
      "model": "hx/minimax-m3"
    },
    "orchestrator": {
      "model": "hx/kimi-k2.6"
    },
    "verify": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "description": "独立验证视角（异源模型复核高风险改动，只读不改动）。仅在认证/权限/支付/数据迁移/公共契约等高风险改动时按需调用。",
      "permission": {
        "edit": "deny",
        // 只读强制力补全：堵 bash 直接写通道（前缀式模式，与主配置同形式；
        // 管道/重定向绕过由 permission-guard 插件按内容二次拦截）
        "bash": {
          "sed -i*": "deny",
          "Set-Content *": "deny",
          "Out-File *": "deny",
          "Add-Content *": "deny",
          "tee *": "deny",
          "Remove-Item *": "deny",
          "rm *": "deny",
          "mv *": "deny",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny",
          "git restore*": "deny",
          "git clean*": "deny",
          "npm install*": "deny",
          "npm ci*": "deny",
          "npm publish*": "deny"
        }
      }
    }
  },

  // ── 上下文压缩（长会话不丢关键信息）─────────────────────────────
  // token 到上下文窗口 85% 时自动触发压缩
  "compaction": {
    "auto": true,
    // 压缩时顺手裁剪老的工具输出（它们最占空间）
    "prune": true,
    // 最近 6 轮用户消息保留原文（含其后 assistant/工具回复）
    "tail_turns": 6,
    // 压缩后最多保 4 万 token 的近期内容不进摘要
    "preserve_recent_tokens": 40000,
    // 给压缩过程本身留 3.2 万 token 缓冲（防溢出）
    "reserved": 32000,
    // 触发阈值（7.6.2 官方字段）
    "threshold_percent": 85
  },

  // ── 工具输出截断（防单条输出撑爆上下文）─────────────────────────
  // 超 2000 行或 20KB：全文落盘，只留预览在上下文里。
  // 51200 让大输出常驻上下文，每轮 prefill 重复付费；落盘的文件模型需要时可重读，无损。
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 20480
  },

  // ── 文件监视忽略（watcher 不盯这些，省 CPU）────────────────────
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "**/*.log",
      "**/__pycache__/**",
      "**/coverage/**",
      ".venv/**",
      "build/**",
      "target/**"
    ]
  },

  // ── git 提交信息生成规则（中文 commit）──────────────────────────
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },

  // ── 权限（安全核心，语义实测与官方文档不同，注意两条）────────────
  // ① 最后一条匹配者生效（非文档说的 first-match）→ 兜底 "*" 必须放最前
  // ② --auto 无人值守下 ask 等于 allow → 想真拦必须写 deny
  // 三道防线：permission-guard 插件(动态) → 本静态规则 → deny 兜底
  "permission": {
    // bash：* 兜底 ask 在最前；具体规则在后覆盖
    "bash": {
      "*": "ask",
      // 只读 git 操作放行
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      // 安全的写操作放行
      "git add*": "allow",
      "git commit*": "allow",
      "git stash*": "allow",
      "git fetch*": "allow",
      "git remote*": "allow",
      "git tag*": "allow",
      "git rev-parse*": "allow",
      "git check-ignore*": "allow",
      "git ls-files*": "allow",
      "git describe*": "allow",
      "git blame*": "allow",
      "git config --get*": "allow",
      // 影响远端/历史的操作要人工确认
      "git push*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git revert*": "ask",
      // 不可逆清空工作区：绝对禁止
      "git clean*": "deny",
      // npm：本地操作放行
      "npm run*": "allow",
      "npm test*": "allow",
      "npm install*": "allow",
      "npm ci*": "allow",
      "npm ls*": "allow",
      "npm view*": "allow",
      "npm outdated*": "allow",
      // 发布类操作：绝对禁止（发布是不可逆的公开行为）
      "npm publish*": "deny",
      "npm unpublish*": "deny",
      "npm pack*": "deny",
      // PowerShell 只读命令放行
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Get-Item *": "allow",
      "Get-FileHash *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow",
      "Measure-Object *": "allow",
      "Get-Process *": "allow",
      // node 任意脚本放行（构建/测试需要；危险操作由插件动态拦）
      "node *": "allow",
      "rg *": "allow",
      // 验证工具链放行（层 2 要求真跑测试/静态检查；与 node * 同风险级别，
      // 高危内容由 permission-guard 动态拦截）：bun/bunx/npx（JS 工具链）、
      // ruff（Python 静态检查）、python（pytest 等）
      "bun *": "allow",
      "bunx *": "allow",
      "npx *": "allow",
      "ruff *": "allow",
      "python *": "allow",
      // 递归强删：绝对禁止（插件层还会按内容二次拦截）
      "rm -rf *": "deny",
      "Remove-Item -Recurse -Force *": "deny"
    },
    // 只读类工具全放行
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    // 子代理派活放行（配合 subagent_depth=2 防失控）
    "task": "allow",
    // 文件编辑：* 兜底 ask 最前 → src 放行 → 锁文件全部 deny
    // （锁文件由包管理器维护，手改必炸；插件层还堵了 sed/node 绕过通道）
    // 非后缀 .lock 的锁文件单列；一切 *.lock 由末尾兜底 deny 覆盖（最后匹配生效）
    "edit": {
      "*": "ask",
      "src/**": "allow",
      "npm-shrinkwrap.json": "deny",
      "**/npm-shrinkwrap.json": "deny",
      "pnpm-lock.yaml": "deny",
      "**/pnpm-lock.yaml": "deny",
      "pnpm-lock.yml": "deny",
      "**/pnpm-lock.yml": "deny",
      "bun.lockb": "deny",
      "*.lock": "deny",
      "**/*.lock": "deny"
    },
    // 访问工作目录之外：要确认
    "external_directory": "ask",
    // 网络读取/搜索放行（凭证路径由插件拦）
    "webfetch": "allow",
    "websearch": "allow",
    // MoA 交叉验证工具：要确认（真实计费；--auto 无人值守下 ask 等同放行）
    "moa": "ask",
    // 双向异源审查（复杂任务交付时正反两路+裁决，3 次上游调用）：
    // allow = quality-gate 在完成节点由插件直调自动执行（无人工确认、不依赖模型手动调）；
    // 这是质量自动闭环的通道；模型也可主动调用审查特定方案
    "dual_review": "allow",
    // 原生记忆读写放行（自我进化的通道，默认 ask 会锁死自主沉淀）
    "kilo_memory_save": "allow",
    "kilo_memory_recall": "allow",
    // LSP 智能放行
    "lsp": "allow",
    // 技能加载放行
    "skill": "allow",
    // 语义搜索放行（代码索引查询）
    "semantic_search": "allow",
    // Playwright MCP 全部工具要确认（浏览器能干的事太多）
    "playwright_*": "ask",
    // 待办读写放行（任务管理）
    "todowrite": "allow",
    "todoread": "allow",
    // 向用户提问放行
    "question": "allow",
    // 死循环检测放行
    "doom_loop": "allow",
    // markdown 源渲染放行
    "markdown_source": "allow",
    // notebook 只读放行，写/执行要确认
    "notebook_read": "allow",
    "notebook_edit": "ask",
    "notebook_execute": "ask"
  },

  // ── MCP 服务器（外挂工具集，工具名前缀 = 服务器名）───────────────
  // 性能口径：每个 enabled 的 MCP 都会在会话启动时拉起进程，且全部工具 schema
  // 每轮都进 prompt（prefill 变大、TTFT 变慢）。低频 MCP 默认关闭，用时 /mcps 现开。
  "mcp": {
    // 浏览器自动化（导航/截图/表单/快照）——低频，按需开
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.38"
      ],
      "enabled": false,
      "timeout": 30000
    },
    // 最新库文档查询（防模型用过期 API）——低频，按需开
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": false,
      "timeout": 30000
    },
    // 代码知识图谱：impact 影响面分析/依赖查询。默认关闭——只对建过索引的项目有用，
    // 未索引项目白占启动进程和 prompt 体积；改已索引项目前 /mcps 现开
    "gitnexus": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "gitnexus@1.6.12",
        "mcp"
      ],
      "enabled": false,
      "timeout": 30000
    }
  },

  // ── 实验开关（7.6.2 支持，已逐个验证）───────────────────────────
  // 子代理可自选模型/推理力度（配 general/explore 路由更灵活）
  // 主子代理共享任务看板（发现互通，不重复探索）
  // batch 工具（多工具调用合并成一轮，省 token）
  "experimental": {
    "task_model_selection": true,
    "shared_agent_board": true,
    "batch_tool": true,
    // OpenTelemetry 关闭
    "openTelemetry": false
  },

  // ── 自研 provider：hx（带四级故障降级）──────────────────────────
  // npm 指向本地自包含包（dist 已打包全部依赖，无 node_modules 依赖）
  // __KILO_CONFIG__ 由 installer 替换为部署目录（file:/// 三斜杠必须）
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "file:///__KILO_CONFIG__/provider/hx-failover",
      "options": {
        // 上游 OpenAI 兼容端点
        "baseURL": "https://xianyu1.natapp4.cc/v1",
        // 单次请求最长 2 分钟：慢响应更早显式报错，由重试/用户接管（原 5 分钟死等太久）
        "timeout": 120000,
        // 流式空闲看门狗：相邻 chunk 间隔超 60s 主动断流（provider 内实现；
        // fetch timeout 只覆盖到响应头，body 阶段挂死靠它兜底）。
        // 60s = 正常流远小于此间隔，又不误伤超长思考不吐字的场景
        "chunkTimeout": 60000,
        // 故障降级链：主模型失败→依次切换，每跳重试 2 次，
        // 失败模型冷却 60s，切换时流首注入 ⚠️ [failover] 可见提示。
        // ※ 模型切换的唯一真源就是本配置文件——provider/moa/dual-review 代码均无内置默认链/兜底模型，
        //   换模型只改这里（agent 路由 / failover / moa / dual_review 都在本文件内）
        "failover": {
          "chain": {
            "models": [
              "glm-5.3-flash",
              "kimi-k2.6",
              "deepseek-v4.1-flash",
              "glm-5.2"
            ]
          }
        },
        // moa 工具配置（plugin/moa.ts 读这里）：高风险判断时
        // 2 个参考模型独立分析 → kimi 聚合交叉结论
        "moa": {
          "references": [
            "glm-5.2",
            "deepseek-v4.1-flash"
          ],
          "aggregator": "kimi-k2.6"
        },
        // dual_review 工具配置（plugin/dual-review.ts 读这里）：三层交付检查层 3，
        // quality-gate 在交付节点直调（正反异源并行 → 第三方裁决）；三模型均与主执行模型异源
        "dual_review": {
          "positive": "deepseek-v4.1-flash",
          "negative": "glm-5.2",
          "aggregator": "kimi-k2.6"
        }
      },
      // 模型注册表（catalog：能力/上下文窗口/输出上限）
      // variants 必须显式声明：hx 的 npm 是 file:/// 本地包，不命中
      // Kilo 自动生成 variants 的白名单（@ai-sdk/openai-compatible 等），
      // 不写则模型选择器里没有"思考强度"选项。key=reasoningEffort 会被
      // openai-compatible 映射成请求体 reasoning_effort 透传给上游网关。
      "models": {
        // 无路由引用；保留作 test-failover.mjs 取消直通回归的桩模型
        "deepseek-v4-flash": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          },
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "deepseek-v4.1-flash": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "glm-5.2": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          },
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "glm-5.3": {
          "reasoning": true,
