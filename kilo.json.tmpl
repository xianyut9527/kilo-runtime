{
  // ══════════════════════════════════════════════════════════════════
  // KiloCode 全局配置（SSOT 模板）
  // 仓库里这份带注释；install 部署时会剥离所有「行首 //」注释行与尾随逗号，
  // 现网 ~/.config/kilo/kilo.json 保持纯 JSON（Kilo 拒绝自定义键，
  // 注释键 "//" 会让整份配置失效 —— 所以只能在模板层注释；
  // 尾随逗号是模板编辑风格，部署侧由 installer 状态机剥离，二者都不落盘）。
  // 改完跑 ./install.ps1（或 ./install.sh）部署，重启 Kilo 生效。
  // ══════════════════════════════════════════════════════════════════
  "$schema": "https://app.kilo.ai/config.json",

  // ── 模型总开关 ──────────────────────────────────────────────────
  // 主力执行模型（default_agent=code 绑定它）。glm-5.3-flash：实测最快档，支持图像输入
  "model": "hx/glm-5.3-flash",
  // 轻任务模型：起会话标题/摘要等后台活，用 deepseek 轻量 flash 档（978fac2 由 minimax-m3 切换）
  "small_model": "hx/deepseek-v4.1-flash",
  // 子代理（task 工具派活）默认模型，深度任务时会按 INSTRUCTIONS 升级到 general
  "subagent_model": "hx/glm-5.3-flash",
  // 子代理最大嵌套深度（防递归失控）：子→孙 两层封顶
  "subagent_depth": 2,
  // 无显式指定 agent 时的默认入口
  "default_agent": "code",

  // ── 官方默认模型过滤 ────────────────────────────────────────────
  // 白名单口径：只启用自研 provider，内置 kilo 网关及 anthropic/openai/google 等
  // 官方默认模型全部不出现在模型选择器（也堵住环境变量自动探测的 provider）。
  // 若将来想精确到 provider 内的单个模型，再用 provider 级 whitelist/blacklist（如 "claude-*"）。
  "enabled_providers": ["hx"],

  // ── 基础行为 ────────────────────────────────────────────────────
  // 会话级快照：每次编辑前存档，可回滚（checkpoint 功能）。安全网，性能专项验证后保持开启。
  "snapshot": true,
  // 扩展自动更新（更新后建议跑 ./install.sh --check 确认渲染一致）
  "autoupdate": true,
  // 会话分享彻底关闭（不出网）
  "share": "disabled",
  // 隐私模式：遥测不上报
  "privacy_mode": true,
  // 允许模型用网络搜索
  "web_search": true,
  // 保存后自动跑 formatter（prettier 等）。性能专项验证后保持开启（关它换不来多少速度，还会漂移代码风格）。
  "formatter": true,
  // LSP 代码智能（跳转/补全/诊断），配合 permission.lsp=allow
  "lsp": true,
  // 远程控制：常驻云端中继连接，会话事件多一条转发通道（49f8ed9/f3caadd 与模型切换同期引入的
  // 变慢嫌疑项）。不用手机端盯任务就关；需要时 /remote 临时开
  "remote_control": false,

  // ── 每会话注入的策略文件（认知中心/风险分级/一次性交付/硬约束）──
  // __KILO_HOME__ 由 installer 替换为本机家目录（Kilo 不展开 ~，必须绝对路径）
  // GLOBAL-NOTES.md 是全自动生长的全局经验层：agent 直接追加（不进下发清单，
  // 属运行时状态非配置；install 不清理清单外文件），/evolve 定期修剪并升格成熟条目
  "instructions": [
    "__KILO_HOME__/.config/kilo/INSTRUCTIONS.md",
    "__KILO_HOME__/.config/kilo/GLOBAL-NOTES.md",
  ],
  // 技能目录：agent 可按需加载领域知识（技能增删无需改配置）
  "skills": {
    "paths": ["__KILO_HOME__/.agents/skills"],
  },

  // ── 智能体路由（前 6 个是内置 agent 的模型覆盖，verify 是自定义）──
  // code         默认执行者：写代码/跑命令，glm-5.3-flash（实测最快档）。
  //              ⚠️ 性能红线：49f8ed9 曾把 code 换成 deepseek-v4.1-flash，日常 95% 任务走 code
  //              agent → 体感全面变慢（git 49f8ed9 即"快→慢"分界，同期还开了 remote_control）。
  //              换主力模型必须单变量切换并实测对比，不得随其他改动捎带调整。
  // plan         规划模式：出方案不动手，用 kimi 换个视角思考
  // general      深度子任务：难啃的实现/分析，用 kimi-k2.6@high（2026-10-03 审计改钉：
  //              原 k2.8 无可用渠道——failover-events 404 "no active channel" 实证；
  //              原注释 glm-5.2 早已 stale。high 档 228 样本零失败分母，max 档有
  //              ≥150k 输入 2.56% 猝死分母且近 7 天 3 例 glm-5.2@max 子代理被 503 秒杀）
  // explore      探索代理（subagent）：只读侦察，用最便宜模型扫代码
  // compaction   上下文压缩：钉 glm-5.3-flash + variant low（2026-09-22 空响应专项：
  //              max 档推理吃光输出预算 → 摘要为空 → "empty response"；schema 规定
  //              variant 仅对 agent 自己配置的 model 生效，model+variant 必须同设）
  // orchestrator 多代理编排：拆解任务分派子代理
  // verify       自定义复核代理（subagent）：异源模型 kimi 复核 glm 的产出
  //              —— 不同厂商交叉验证，只读不许改（edit/bash写通道均 deny）
  // variant 策略（2026-09-24 二轮修正，证伪了「low/medium 零失败」的旧论述）：
  // kilo.db finish=length 95 条实证（reasoning 吃光输出预算 → "output limit while
  // reasoning"，正常流结束不触发 failover/重试）按档位分桶：kimi@max 全库 7/964
  // （≥150k 输入条件猝死率 2.56%），kimi@high 228 条含 85k+ 长输入 183 条全零失败，
  // kimi@medium 全库 0 次调用（无分母）；网关直连探针 further 证伪「降档缩短推理」：
  // kimi max/high/medium 在 max_tokens=2048 下全部死亡，reasoning 长度与档位无关。
  // 故深思考位钉 high（有分母的正面数据），浅思考位钉 low；根治已下沉到 provider
  // reasoningGate（扣留检测 + 死亡自动扩预算重试，见 provider.hx.options 注释）。
  "agent": {
    "code": {
      "model": "hx/glm-5.3-flash",
      // 一次输出质量杠杆：钉 max（2026-09-30 升档，2026-10-07 复核定案保留）。
      // 2026-09-28 先钉 high 的依据是「上游默认档深思考不足 → 首过质量不稳 → 返工」；
      // 09-30 升 max 的补充依据：① kimi@max 长输入猝死是 k2.6 分母的负数据，对 glm 族
      // 无直接证据；② reasoningGate v2 死亡自动扩预算（×2、clamp 32768-65536）+ 降档
      // 重试已兜住 max 档的 length 猝死；③ 95% 工作走本槽，思考深度对首过质量的传递
      // 放大最大。代价＝思考期首字间隔变长，本机实测 max 档首字 41s（对照 low/high 6s）
      // ——若日后确认「慢」主要来自本档，按单变量 A/B（同任务 code@high vs code@max）
      // 复核后再回退，不要在没有对照的情况下反复改这一行。
      "variant": "max",
    },
    "plan": {
      "model": "hx/kimi-k3",
      // 规划位钉 max（2026-09-30，质量顶级口径）：K3 官方 reasoning_effort 默认即
      // max（低频单发规划，延迟代价小，规划质量向实现质量传递放大）。
      // ⚠️ 分母口径：kilo.db「85k+ 长输入 183 条零失败 / max ≥150k 猝死 2.56%」
      // 是 kimi-k2.6 的实测分母，对 K3 不直接适用（K3 本机尚无分母，死亡由
      // reasoningGate 扩预算+降档重试兜底；K3 无 medium 档，重试链降档到 high）。
      // 原「medium 零失败」论述已证伪（k2.6 时代 medium 全库 0 次调用，无分母）。
      "variant": "max",
    },
    "general": {
      // 2026-10-03 收口审计改钉：k2.8 无渠道（404 no active channel，全天实证），
      // 深度子代理全部靠 failover 兜底跑在降级档上——执行面钉回有渠道、有安全分母的 k2.6@high
      "model": "hx/kimi-k2.6",
      "variant": "high",
    },
    "explore": {
      "model": "hx/deepseek-v4.1-flash",
      // 粗扫侦察不需要深思考；deepseek-v4.1-flash 大输入高档死亡实证（85k+ @max
      // 0.48%/call）→ low；粗扫会话输入天然偏大，钉低档规避
      "variant": "low",
    },
    "compaction": {
      // 压缩是摘要任务，不需要深度推理，钉 low 档（max 档思考预算深、纯推理打满则
      // 0 输出 → "Compaction worker returned an empty response"，kilo.db 30 条实测；
      // schema 约束：variant 仅在 agent 用「自己配置的 model」时生效——必须同时钉死
      // model，否则 compaction 继承会话当前模型+variant，覆盖不生效）。
      // 2026-10-07 kimi-k3 → deepseek-v4.1-flash（本行当日被改过两次，此处回滚到实测
      // 站得住的选项）：
      //  · kimi-k3 在压缩位**实测失败**——本轮直连复现 4 次压缩尺寸（400KB 负载）
      //    全部命中 opencode.log 的 "Compaction worker returned an empty response",
      //    content_len=0 且 reasoning 打满 max_tokens=8192；而 deepseek-v4.1-flash
      //    同一负载稳定产出 195 字摘要、耗时 9.9s（glm-5.3-flash 16.1s / kimi-k3 21.9s
      //    且空输出）。压缩位空响应 = 会话不收敛 → 每步重新上传全量负载，
      //    这是「越用越卡」的直接机制。
      //  · 该模型另有全库最大分母的零空响应记录（11 跑 0 空）与最快的压缩墙钟。
      //  · kimi-k3 仍是 plan 位模型（那一位实跑正常）——本处只动压缩位。
      // 窗口口径：压缩模型窗口 = 会话负载的回收上限；deepseek-v4.1-flash 登记
      // 200k/32k（与上游实际一致，见 models 表）。越窗的极端会话由「tool_output
      // 8KB 限流 + failover 换路」兜底，不再靠改这一个数字解决。
      "model": "hx/deepseek-v4.1-flash",
      "variant": "low",
    },
    "orchestrator": {
      "model": "hx/deepseek-v4.1-flash",
      // 编排拆解分派子代理，不需要深思考；kimi@max 7 条 length 失败实证 → low
      "variant": "low",
    },
    "verify": {
      "mode": "subagent",
      // k2.8 无渠道（2026-10-03 404 实证）→ 同源异厂改钉 k2.6（复核位保持与 code 的 glm 族异源）
      "model": "hx/kimi-k2.6",
      // 复核保留思考深度 → high（与 plan 同据；原「kimi@high 有 1 条失败」是把
      // 流中断计入的旧数据，95 条 length 地面真值里 high 档为零）
      "variant": "high",
      "description": "独立验证视角（异源模型复核高风险改动，只读不改动）。仅在认证/权限/支付/数据迁移/公共契约等高风险改动时按需调用。",
      "permission": {
        "edit": "deny",
        // 只读强制力补全：堵 bash 直接写通道（前缀式模式，与主配置同形式；
        // 管道/重定向绕过由 permission-guard 插件按内容二次拦截）
        "bash": {
          "sed -i*": "deny",
          "Set-Content *": "deny",
          "Out-File *": "deny",
          "Add-Content *": "deny",
          "tee *": "deny",
          "Remove-Item *": "deny",
          "rm *": "deny",
          "mv *": "deny",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny",
          "git restore*": "deny",
          "git clean*": "deny",
          "npm install*": "deny",
          "npm ci*": "deny",
          "npm publish*": "deny",
        },
      },
    },
  },

  // ── 上下文压缩（长会话不丢关键信息）─────────────────────────────
  "compaction": {
    "auto": true,
    // 压缩时顺手裁剪老的工具输出（它们最占空间）
    "prune": true,
    // 最近 6 轮用户消息保留原文（含其后 assistant/工具回复）
    "tail_turns": 6,
    // 压缩后最多保 2.4 万 token 的近期内容不进摘要（40000→24000，2026-10-07）。
    // 与 tool_output 8KB 上限配套：尾巴本身被截断后已很轻，2.4 万足够覆盖最近
    // 6 轮原文；把省下的 1.6 万 token 让给「压缩后每步重新付费」的常驻负载。
    "preserve_recent_tokens": 24000,
    // 给压缩过程本身留 3.2 万 token 缓冲（防溢出）
    "reserved": 32000,
    // 触发阈值（7.6.2 官方字段）= 上下文窗口百分比。
    // 2026-10-07 还原 85：本机 doom-lock 事件的真实尺寸是 1.25-1.8MB（≈31-45 万
    // token，见 opencode.log「payload still large after pruning」最大 18.1MB 记录），
    // 远高于 200k 窗，任何 70/80/85 阈值都拦不住一次 30 万 token 的越窗跃迁——
    // 降阈值只是让压缩更频繁（每轮一次 low-variant 后台调用），并不解决越窗。
    // 真正的兜底是 ① tool_output 8KB 让负载涨得慢、② 压缩位模型必须有足够大的窗
    // （见 agent.compaction 与 models.<compaction model>.limit.context）。
    "threshold_percent": 85,
  },

  // ── 工具输出截断（防单条输出撑爆上下文）─────────────────────────
  // 超 800 行或 8KB：全文落盘，只留预览在上下文里（可重读，无损）。
  // 2026-10-07 实测收口：原 20480B 的单条工具输出 ≈5k token，且**每一步都被完整
  // 重传一遍**——本机上游 prompt 缓存实测不生效（kilo.db：cache.read 有值但
  // cache.write 恒 0，每步全量 prefill），实测真实 prompt ≈ p50 100k / p90 146k
  // token（input+cache.read+write，近 3 天 22.5k 步），p90 单步 32s、p99 184s。
  // 大头就是历史里堆积的大工具输出：read 一类就累计 406MB（kilo.db 按 tool 分桶），
  // 今日单条最大 read 输出 373KB。20KB→8KB 让常驻上下文的输出量降到 ≈2k token/条，
  // 落盘全文仍可重读——这是「每步重新付费」的唯一直接杠杆。
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 8192,
  },

  // ── 文件监视忽略（watcher 不盯这些，省 CPU）────────────────────
  // glob 语义：根锚定的 node_modules/** 只匹配仓库根，monorepo 子包的同名目录漏盯
  // → 目录型模式一律 **/ 前缀（**/ 匹配零或多层目录，根与嵌套都命中）
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.git/**",
      "**/*.log",
      "**/__pycache__/**",
      "**/coverage/**",
      "**/.venv/**",
      "**/build/**",
      "**/target/**",
      // 构建/测试缓存（2026-09-29 P2 补丁裁决）
      "**/.cache/**",
      "**/.turbo/**",
      "**/.pytest_cache/**",
    ],
  },

  // ── git 提交信息生成规则（中文 commit）──────────────────────────
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）",
  },

  // ── 权限（安全核心，语义实测与官方文档不同，注意两条）────────────
  // ① 最后一条匹配者生效（非文档说的 first-match）→ 兜底 "*" 必须放最前
  // ② --auto 无人值守下 ask 等于 allow → 想真拦必须写 deny
  // 三道防线：permission-guard 插件(动态) → 本静态规则 → deny 兜底
  "permission": {
    // bash：* 兜底 ask 在最前；具体规则在后覆盖
    "bash": {
      "*": "ask",
      // 只读 git 操作放行
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      // 安全的写操作放行
      "git add*": "allow",
      "git commit*": "allow",
      "git stash*": "allow",
      "git fetch*": "allow",
      "git remote*": "allow",
      "git tag*": "allow",
      "git rev-parse*": "allow",
      "git check-ignore*": "allow",
      "git ls-files*": "allow",
      "git describe*": "allow",
      "git blame*": "allow",
      "git config --get*": "allow",
      // 影响远端/历史的操作要人工确认
      "git push*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git revert*": "ask",
      // 不可逆清空工作区：绝对禁止
      "git clean*": "deny",
      // npm：本地操作放行
      "npm run*": "allow",
      "npm test*": "allow",
      "npm install*": "allow",
      "npm ci*": "allow",
      "npm ls*": "allow",
      "npm view*": "allow",
      "npm outdated*": "allow",
      // 发布类操作：绝对禁止（发布是不可逆的公开行为）
      "npm publish*": "deny",
      "npm unpublish*": "deny",
      "npm pack*": "deny",
      // PowerShell 只读命令放行
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Get-Item *": "allow",
      "Get-FileHash *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow",
      "Measure-Object *": "allow",
      "Get-Process *": "allow",
      // node 任意脚本放行（构建/测试需要；危险操作由插件动态拦）
      "node *": "allow",
      "rg *": "allow",
      // 验证工具链放行（层 2 要求真跑测试/静态检查；与 node * 同风险级别，
      // 高危内容由 permission-guard 动态拦截）：bun/bunx/npx（JS 工具链）、
      // ruff（Python 静态检查）、python（pytest 等）
      "bun *": "allow",
      "bunx *": "allow",
      "npx *": "allow",
      "ruff *": "allow",
      "python *": "allow",
      // 递归强删：绝对禁止（插件层还会按内容二次拦截）
      "rm -rf *": "deny",
      "Remove-Item -Recurse -Force *": "deny",
      // Windows 破坏性命令静态拦截（2026-09-29 P2 补丁裁决）：磁盘格式化/分区 + 动态执行。
      // format 带空格锚定（format C:），Format-Table/Format-List 等只读 cmdlet 连字符形态不命中；
      // diskpart* 覆盖裸交互模式与 /s 脚本形态；Invoke-Expression/iex 执行任意字符串、
      // 绕过一切前缀式静态规则，必须 deny（编码/拼接等动态变形由 permission-guard 二次拦截）
      "format *": "deny",
      "format.com *": "deny",
      "Format-Volume*": "deny",
      "diskpart*": "deny",
      "Invoke-Expression *": "deny",
      "Invoke-Expression(*": "deny",
      "iex *": "deny",
      "iex(*": "deny",
    },
    // 只读类工具全放行
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    // 子代理派活放行（配合 subagent_depth=2 防失控）
    "task": "allow",
    // 文件编辑：* 兜底 ask 最前 → src 放行 → 锁文件全部 deny
    // （锁文件由包管理器维护，手改必炸；插件层还堵了 sed/node 绕过通道）
    // 非后缀 .lock 的锁文件单列；一切 *.lock 由末尾兜底 deny 覆盖（最后匹配生效）
    "edit": {
      "*": "ask",
      "src/**": "allow",
      // package-lock.json 不以 .lock 结尾，末尾 *.lock 兜底盖不住 → 必须单列。
      // permission-guard 插件 PROTECTED_PATH 已含它；此处补静态层，使插件被降级禁用时锁文件防线仍独立成立。
      "package-lock.json": "deny",
      "**/package-lock.json": "deny",
      "npm-shrinkwrap.json": "deny",
      "**/npm-shrinkwrap.json": "deny",
      "pnpm-lock.yaml": "deny",
      "**/pnpm-lock.yaml": "deny",
      "pnpm-lock.yml": "deny",
      "**/pnpm-lock.yml": "deny",
      "bun.lockb": "deny",
      "*.lock": "deny",
      "**/*.lock": "deny",
    },
    // 访问工作目录之外：要确认
    "external_directory": "ask",
    // 网络读取/搜索放行（凭证路径由插件拦）
    "webfetch": "allow",
    "websearch": "allow",
    // MoA 交叉验证工具：要确认（真实计费；--auto 无人值守下 ask 等同放行）
    "moa": "ask",
    // 双向异源审查（复杂任务交付时正反两路+裁决，3 次上游调用）：
    // allow = quality-gate 在完成节点由插件直调自动执行（无人工确认、不依赖模型手动调）；
    // 这是质量自动闭环的通道；模型也可主动调用审查特定方案
    "dual_review": "allow",
    // 原生记忆读写放行（自我进化的通道，默认 ask 会锁死自主沉淀）
    "kilo_memory_save": "allow",
    "kilo_memory_recall": "allow",
    // LSP 智能放行
    "lsp": "allow",
    // 技能加载放行
    "skill": "allow",
    // 语义搜索放行（代码索引查询）
    "semantic_search": "allow",
    // Playwright MCP 全部工具要确认（浏览器能干的事太多）
    "playwright_*": "ask",
    // 待办读写放行（任务管理）
    "todowrite": "allow",
    "todoread": "allow",
    // 向用户提问放行
    "question": "allow",
    // 死循环检测放行
    "doom_loop": "allow",
    // markdown 源渲染放行
    "markdown_source": "allow",
    // notebook 只读放行，写/执行要确认
    "notebook_read": "allow",
    "notebook_edit": "ask",
    "notebook_execute": "ask",
  },

  // ── MCP 服务器（外挂工具集，工具名前缀 = 服务器名）───────────────
  // 性能口径：每个 enabled 的 MCP 都会在会话启动时拉起进程，且全部工具 schema
  // 每轮都进 prompt（prefill 变大、TTFT 变慢）。低频 MCP 默认关闭，用时 /mcps 现开。
  "mcp": {
    // 浏览器自动化（导航/截图/表单/快照）——低频，按需开
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.38"],
      "enabled": false,
      "timeout": 30000,
    },
    // 最新库文档查询（防模型用过期 API）——低频，按需开
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": false,
      "timeout": 30000,
    },
    // 代码知识图谱：impact 影响面分析/依赖查询。默认关闭——只对建过索引的项目有用，
    // 未索引项目白占启动进程和 prompt 体积；改已索引项目前 /mcps 现开
    "gitnexus": {
      "type": "local",
      "command": ["npx", "-y", "gitnexus@1.6.12", "mcp"],
      "enabled": false,
      "timeout": 30000,
    },
  },

  // ── 主子代理共享任务看板（7.7.6 从 experimental 升格为顶层键）──
  "shared_agent_board": true,

  // ── 实验开关（7.6.2 支持，已逐个验证）───────────────────────────
  // 子代理可自选模型/推理力度（配 general/explore 路由更灵活）
  // batch 工具（多工具调用合并成一轮，省 token）
  "experimental": {
    "task_model_selection": true,
    "batch_tool": true,
    // OpenTelemetry 关闭
    "openTelemetry": false,
  },

  // ── 自研 provider：hx（带四级故障降级）──────────────────────────
  // npm 指向本地自包含包（dist 已打包全部依赖，无 node_modules 依赖）
  // __KILO_CONFIG__ 由 installer 替换为部署目录（file:/// 三斜杠必须）
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "file:///__KILO_CONFIG__/provider/hx-failover",
      "options": {
        // 上游 OpenAI 兼容端点（SSOT 唯一真源）。
        // ⚠️ 防回归（2026-10-08）：不要改回 openllamas.com 或 xianyu1.natapp4.cc —— 两者均对
        // 当前 key 返回 401（实测探针）。任何改动前必须先 curl 探针验证新端点认 key。
        // 2026-10-07 还原：4807907 把本行改回 openllamas.com 是无依据的改动 —— 实测
        // openllamas.com 对当前 key 返回 401 INVALID_API_KEY（curl 探针），而
        // llamas.nat100.top 对该 key 返回 200 且模型齐全。endpoint 失效是「极慢」的
        // 直接放大器：每个 hop 先打一个 401/超时，failover 再退避重试下一个模型，
        // 单步墙钟成倍拉长。b9965ef 记录的迁移（natapp4）后又发现 natapp4 也不认
        // 当前 key（401 Invalid token），故回到 llamas.nat100.top（实测可用）。
        "baseURL": "https://llamas.nat100.top/v1",
        // MoA/dual_review 分析调用总时长上限（kilo.json options.timeout 唯一消费方 = 这两个工具）。
        // ⚠️ 主模型循环不消费本键（provider/hx-failover 不读它，2026-09-21 DB 实证：
        // 27 例 >120s 的 step-finish 正常完成，120s 从未生效于主链路；主链路只有 chunkTimeout 空闲看门狗）。
        // 120s→300s：与 hx-client 流式设计口径对齐（其缺省兜底即 300s），避免长审查被 2 分钟硬切。
        // 300s→480s（2026-09-29 P1 落地，多模型审查裁决）：300s 仍硬切慢聚合器——实证
        // 2026-09-29 01:32 UTC kimi-k2.6 聚合器 ask_fail timeout_total elapsedMs=300044，
        // 审查结论整段丢失。420-480s 裁决区间取上限：主链路不消费本键，加大无副作用。
        "timeout": 480000,
        // 流式空闲看门狗：相邻 chunk 间隔超 180s 主动断流（provider 内实现；
        // fetch timeout 只覆盖到响应头，body 阶段挂死靠它兜底）。
        // 60s→90s→180s（2026-09-23 主链路误杀专项续）：thinking 模型静默思考期
        // 不发 SSE（首 chunk 前 + 流中途换相均可能），60s/120s 档分别留下
        // 62-69s / 120.6s 两个被杀簇（kilo.db + failover-events.jsonl 实证，
        // chunks=37 后静默 120s+ 仍被杀）；成功对照组也在 55-75s 带。
        // 180s 覆盖 p95+ 合法思考，真挂死代价上限 3 分钟（failover/手动重发兜底）。
        "chunkTimeout": 180000,
        // thinking 模型协议兜底（2026-09-21 reasoning_content 400 专项）：
        // DeepSeek V4/Kimi K2.6/GLM-5.x/MiniMax 上游要求历史 assistant 消息回传
        // reasoning_content（工具循环续跑必查）；Kilo 历史重放不保留该字段 →
        // 上游 400「must be passed back」直达用户（kilo.db 实证全命中 deepseek-v4.1-flash，
        // 400 不重试不降级、降级日志无痕）。开启后 provider 在出站请求体给缺失该字段的
        // assistant 消息补空串：四家上游直连实测均接受；真实思考文本客户端不留存无法恢复，
        // 空串是协议层标准兜底（opencode-thinking-fix 同款方案）。已有真实值不覆盖。
        "reasoningEcho": true,
        // 推理门控（2026-09-24「推理吃光输出预算」专项根治，provider 内实现）：
        // thinking 模型推理与正文共享 max_tokens，推理打满预算 → 正文空 +
        // finish=length（正常流结束，不触发 failover/重试）。开启后 provider 在
        // fetch 出口扣留响应直到出现正文/工具调用才放行；判定死亡则用「扩预算
        // （×2、下限 32768、上限 65536）+ 降推理档」的请求体自动重发 1 次，
        // 仍死则原样透传（与关闭时字节一致）。9527 网关是无源码 new-api 二进制，
        // 服务端改不了 → 客户端兜底。可调对象：{holdMs, retries, minTokens, maxTokens, toolHoldMs}。
        // v2（2026-09-29 Tool-execution-aborted 专项）：工具调用原子化——tool_calls 起始后
        // 扣留到流尾才回放（inter-chunk 超时 toolHoldMs，默认 120s，断流重试零重复）；
        // tool_calls+finish=length 参数被输出预算截断 → 扩预算重发（遥测 reason=truncated_tool_args）。
        "reasoningGate": true,
        // 故障降级链：主模型失败→依次切换，每跳重试 2 次，
        // 失败模型冷却 60s（冷却对全链生效：主模型上一轮刚降级过，本轮直接从首个
        // 未冷却备用起跑，省去对已知故障模型的 3 连重试+退避；主模型与备用全冷却
        // 时仍从主模型起跑——空转不如再试一次），切换时流首注入 ⚠️ [failover] 可见提示
        // （同一「主模型→备用」的提示在冷却窗口内只注入一次，持续故障期不刷屏）。
        // 过载感知退避（2026-09-24 Tool execution aborted 专项）：503/cpu overloaded/
        // Retry-After 类错误退避 2s/6s（给 CPU 99%+ 的网关喘息窗口，对齐 lib/hx-client
        // OVERLOAD_BACKOFF_MS），普通可重试错误仍 500/1500ms；retry 遥测带 overload:true。
        // failover.overloadBackoffMs 可注入覆盖（测试用，缺省 [2000,6000]）；
        // failover.noticeCooldownMs 可单独调通知去重窗口（缺省 = cooldownMs）。
        // ※ 模型切换的唯一真源就是本配置文件——provider/moa/dual-review 代码均无内置默认链/兜底模型，
        //   换模型只改这里（agent 路由 / failover / moa / dual_review 都在本文件内）
        // 链序（2026-09-25 多模型审查优化）：同族优先——首跳 glm-5.2 而非 kimi。
        // 理由：failover 是质量敏感场景的高发路径（主模型失败常伴随长任务），首跳即切异构
        // 厂商模型会造成风格/能力断裂，同一批文件被异构模型交替编辑；同族补位保连续性，
        // glm-5.2@max 能力足以承接执行（MoA 双路一致认定）。代价是跳到较慢大杯——
        // 质量优先场景下可接受；末跳仍保留异构兜底。
        "failover": {
          "chain": {
            "models": [
              "glm-5.3-flash",
              "deepseek-v4.1-flash",
              "glm-5.2",
              "kimi-k2.6",
            ],
          },
        },
        // moa 工具配置（plugin/moa.ts 读这里）：高风险判断时
        // 2 个参考模型独立分析 → kimi 聚合交叉结论
        "moa": {
          "references": ["glm-5.2", "deepseek-v4.1-flash"],
          "aggregator": "kimi-k2.6",
        },
        // dual_review 工具配置（plugin/dual-review.ts 读这里）：三层交付检查层 3，
        // quality-gate 在交付节点直调（正反异源并行 → 第三方裁决）；三模型均与主执行模型异源
        "dual_review": {
          "positive": "deepseek-v4.1-flash",
          "negative": "glm-5.2",
          "aggregator": "kimi-k2.6",
        },
      },
      // 模型注册表（catalog：能力/上下文窗口/输出上限）
      // variants 必须显式声明：hx 的 npm 是 file:/// 本地包，不命中
      // Kilo 自动生成 variants 的白名单（@ai-sdk/openai-compatible 等），
      // 不写则模型选择器里没有"思考强度"选项。key=reasoningEffort 会被
      // openai-compatible 映射成请求体 reasoning_effort 透传给上游网关。
      "models": {
        // 无路由引用；保留作 test-failover.mjs 取消直通回归的桩模型
        "deepseek-v4-flash": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },
        "deepseek-v4.1-flash": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },
        "glm-5.2": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },
        "glm-5.3": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },
        "glm-5.3-flash": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },
        "kimi-k2.6": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },
        "kimi-k2.8": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },        
        "kimi-k3": {
          "reasoning": true,
          // K3 官方仅支持 low/high/max 三档（默认 max），无 medium——多声明会产生
          // 无效选择项，且 reasoningGate 死亡重试降档链（high→medium）会向 K3 发出
          // 非法 reasoning_effort → 重试 400，救活路径落空。故只声明三档，降档链
          // 对 K3 的落点为 high（合法值中比 max 低一档的最近值）。
          "variants": {
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            // 2026-10-07 还原 600k→200k：600k 是本机从未有渠道验证过的数字（当日
            // 与压缩换岗一起写入，随后实测 kimi-k3 在压缩位直接空响应，见
            // agent.compaction 注释）。registry 里的 context 会参与上下文占用计算，
            // 一个未经验证的大窗数字会让「何时该压缩」的判断失真。回到与上游实际
            // 一致的 200k；K3 若日后确有更大窗可用，按实测再放宽。
            "context": 200000,
            "output": 32000,
          },
        },
        "minimax-m3": {
          "reasoning": true,
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
