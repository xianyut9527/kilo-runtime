{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/MiniMax-M3",
  "small_model": "hx/MiniMax-M2.7-highspeed",
  "default_agent": "conductor",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 5,
    "preserve_recent_tokens": 40000,
    "reserved": 8000
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "agent": {
    "conductor": {
      "mode": "primary",
      "model": "hx/kimi-k3",
      "prompt": "你是工作流编排者（conductor）。先做意图判定（咨询类/执行类）与定级（T0-T3），按 lifecycle/ 阶段加载智能体，管理 task_context，执行交叉验证门禁；compaction 后按 task_context 恢复流转。"
    },
    "multiModel": {
      "mode": "primary",
      "model": "hx/kimi-k2.6",
      "prompt": "你是多模型编排者（multiModel）。调度 3 coder + verifier + synthesizer-fusion 执行 T3 子图。"
    },
    "synthesizer-fusion": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "prompt": "你是融合编辑智能体（synthesizer-fusion）。整合多 coder 输出与验证结果，生成最优方案。只融合，不推理，不验证。"
    },
    "planner": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "prompt": "你是规划智能体（planner）。输出设计方案（含 DAG、验收点、扫描清单）。只设计，不写代码，不执行。"
    },
    "plan-reviewer": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "prompt": "你是方案审查智能体（plan-reviewer）。独立审查 planner 方案。只审查，不修复，不重写。"
    },
    "coder": {
      "mode": "subagent",
      "model": "hx/kimi-k2.7-code",
      "prompt": "你是编码智能体（coder）。按方案实现代码，输出验收映射表+三件套。端到端闭环。不设计，不审查，不审计。"
    },
    "coder-a": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "description": "multiModel 逻辑推理派 coder，专精复杂推理与边界发现",
      "prompt": "你是编码智能体 coder-a（逻辑推理派）。侧重逻辑完备与边界条件。按方案实现，输出三件套。不设计，不审查，不审计。"
    },
    "coder-b": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "description": "multiModel 安全边界派 coder，专精防御性编程与风险识别",
      "prompt": "你是编码智能体 coder-b（安全边界派）。侧重安全边界与防御性编程。按方案实现，输出三件套。不设计，不审查，不审计。"
    },
    "coder-c": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "description": "multiModel 代码生成派 coder，专精代码风格一致与最小改动",
      "prompt": "你是编码智能体 coder-c（代码生成派）。侧重风格一致与最小改动。按方案实现，输出三件套。不设计，不审查，不审计。"
    },
    "verifier": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "prompt": "你是正向验证智能体（verifier）。逐条验证验收标准，输出 L1/L2/L3 五元组证据。只验证，不修复。"
    },
    "reverse-auditor": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "prompt": "你是反向审计智能体（reverse-auditor）。反推需求满足度，追溯假设，发现遗漏。只审计，不修复。"
    },
    "side-checker": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "prompt": "你是侧向验证智能体（side-checker）。实测验证边界、安全、性能、兼容性。只验证，不修复。"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "prompt": "你是代码审查智能体（reviewer）。审查安全/架构/简化/SCOPE_CREEP 四视角。只审查，不修复。"
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "prompt": "你是修复智能体（fixer）。定向修复阻塞问题。修复后不自验。"
    }
  },
  "skills": {
    "paths": ["${KILO_CONFIG_DIR}/.kilo/skills", "${HOME}/.agents/skills"]
  },
  "permission": {
    "bash": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": ["npx", "gitnexus", "mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp"],
      "enabled": true,
      "timeout": 120000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://huixin.nat100.top/v1",
        "timeout": 600000,
        "chunkTimeout": 180000
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k3": {
          "name": "kimi-k3",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    }
  }
}
