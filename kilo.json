{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "hsyq/doubao-seed-2.0-mini",
  "default_agent": "coderAgent",
  "instructions": ["./AGENTS.md"],
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "edit": {
      "*": "ask"
    }
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "provider": {
    "hsyq": {
      "name": "hsyq",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/plan/v3"
      },
      "models": {
        "glm-5.1": {
          "name": "glm-5.1",
          "reasoning": true
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true
        },
        "doubao-seed-2.0-mini": {
          "name": "doubao-seed-2.0-mini"
        }
      }
    }
  }
}
