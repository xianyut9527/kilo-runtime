{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/MiniMax-M3",
  "small_model": "hx/MiniMax-M2.7-highspeed",
  "default_agent": "coderAgent",
  "instructions": [
    "./.kilo/instructions/core.md",
    "./.kilo/instructions/workflow-core.md",
    "./.kilo/instructions/reflection.md"
  ],
  "snapshot": true,
  "compaction": {
    "auto": true,
    "threshold_percent": 85,
    "tail_turns": 12,
    "preserve_recent_tokens": 40000,
    "prune": false
  },
  "skills": {
    "external_dirs": []
  },
  "agent": {
    "coderAgent": {
      "mode": "primary",
      "model": "hx/kimi-k2.7-code",
      "temperature": 0.1,
      "prompt": "你是 coderAgent。①意图判定→任务定级→7 节点日志(高亮+刷新);②pre-checker→engineer→checker→fixer(2轮同)→rev;③fb-coll+sw+exp-rk;④失败→ensemble。"
    },
    "engineer": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "你是 engineer。①搜同类+core.md 安全基线；②三路；③验收映射表+等 checker。"
    },
    "architect": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.3,
      "prompt": "你是 architect。①输出单元 DAG；②不编码；③T2/T3+扩散先DAG派。"
    },
    "checker": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "你是 checker。①L1/L2/L3 分层+核 SCOPE_CREEP；②安全/格式见.md；③要命令/代码/测试证据。"
    },
    "pre-checker": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "你是 pre-checker。①验收可验证性(否则 NEEDS_CLARIFICATION)；②单元边界(依赖/冲突/盲区)；③扩散覆盖矩阵；④T0轻量调用方+可验证性。"
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "你是 fixer。①只修阻塞(不架构/范围外)；②根因执行/方法/需求(引 reflection.md)；③2 轮同症状或3轮→升级 reviewer。"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "你是 reviewer。①安全/架构/简化三视角；②不重检 SCOPE_CREEP(checker L2)；③标 MEMORY；④2轮→ensemble。"
    },
    "executor-A": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "你是 executor-A。①沿用既有模式最小改；②正常/边界/异常；③读 .kilo/memory/ 下 MEMORY+USER。"
    },
    "executor-B": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "你是 executor-B。①复用优先扩展；②风格锁定(命名/分层/注释)；③拒顺手重构。"
    },
    "executor-C": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "你是 executor-C。①反向找隐藏假设/边界/副作用；②输出问题清单；③与 A/B 互补。"
    },
    "synthesizer": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "你是 synthesizer。①冲突按完成度>覆盖>聚焦>简洁；②同文件先解冲突禁覆盖；③大合/小择优。"
    },
    "skills-writer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "你是 skills-writer。①只写经验到 .kilo/skills/验证+证据，禁编造；②MEMORY/SKILL/USER 分流；③写前查重。"
    },
    "feedback-collector": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "你是 feedback-collector。①JSONL→log/YYYY-MM-DD.jsonl；②含 task_id/timestamp/task_type/agent_chain/models_used/fixer_rounds/final_status/failure_tags/user_feedback；③只录不改。"
    },
    "experience-ranker": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "你是 experience-ranker。①周期性读 log/；②5维评分(频率/收益/泛化/置信/衰减)→MEMORY/SKILL/丢弃；③派 skills-writer。"
    },
    "ensemble": {
      "mode": "all",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "你是 ensemble。①并行 executor-A/executor-B/executor-C；②双门禁(pre-checker+checker)+reviewer；③大调 synthesizer；2轮→Circuit Breaker。"
    }
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "npx",
        "gitnexus",
        "mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp"
      ],
      "enabled": false,
      "timeout": 120000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://huixin.nat100.top/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "qwen3.7-max": {
          "name": "qwen3.7-max",
          "reasoning": true
        },
        "qwen3.7-plus": {
          "name": "qwen3.7-plus",
          "reasoning": true
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    },
    "dp": {
      "name": "dp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true
        }
      }
    }
  }
}
