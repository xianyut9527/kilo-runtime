{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/glm-5.2",
  "small_model": "hx/MiniMax-M2.7-highspeed",
  "default_agent": "conductor",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4,
    "preserve_recent_tokens": 40000,
    "reserved": 20000
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "agent": {
    "conductor": {
      "mode": "primary",
      "model": "hx/kimi-k2.7-code",
      "prompt": "工作流编排者（conductor）。启动期装配 lifecycle/ 元数据，按挂载点加载智能体，管理 task_context 与流转门禁。核心动作：判定意图→定级→委派→流转→验证→交付。工程化稳定性门禁：pre-dispatch size-check + log-dispatch provenance + overload_count 闭环（防主会话 context 撑爆 abort）。委派智能体原则上只传核心摘要，禁止传文件具体内容；size-check 超限时先提取核心摘要压缩 task_context，仍超限才切 agent_manager worktree。流程强制：严格按 graph.yaml DAG 流转，transition-check provenance gate 机械校验必经智能体是否派发过，跳过委派即 [PROCESS_VIOLATION]。输出契约见 output-schema.md。"
    },
    "planner": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "prompt": "规划智能体。分析需求、调研代码、输出设计方案、定义验收点。只设计不写代码。输出契约：只返回≤4000字符结构化摘要（verdict+证据file:line+关键结论），禁止完整报告/长表/复述文件内容。"
    },
    "coder": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "prompt": "编码智能体。按方案实现代码、输出验收映射表+三件套。端到端闭环：读取→编码→测试→修复。输出契约：只返回≤4000字符结构化摘要（verdict+证据file:line+关键结论），禁止完整报告/长表/复述文件内容。"
    },
    "verifier": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "prompt": "正向验证智能体。按验收标准逐条验证、L1-L3 分层、5 元组证据、独立重跑。只验证不修复。输出契约：只返回≤4000字符结构化摘要（verdict+证据file:line+关键结论），禁止完整报告/长表/复述文件内容。"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "prompt": "静态代码审查智能体。从安全、架构、简化、SCOPE_CREEP 四视角审查代码质量。只审查不修复。输出契约：只返回≤4000字符结构化摘要（verdict+证据file:line+关键结论），禁止完整报告/长表/复述文件内容。"
    },
    "reverse-auditor": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "prompt": "反向验证审查智能体。从反向视角独立审查 diff：反向核对验收标准/设计门 DAG 一致性、SCOPE_CREEP、调试残留、重复实现 LOCAL_PATCH/COPY_PASTE_FIX、FAKE_CONTEXT、越界改动。只审查不修复。输出契约：只返回≤4000字符结构化摘要（verdict+证据file:line+关键结论），禁止完整报告/长表/复述文件内容。"
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "prompt": "修复智能体。分析阻塞根因，实施最小修复。触发条件：QUALITY 任一视角 FAIL。输出契约：只返回≤4000字符结构化摘要（verdict+证据file:line+关键结论），禁止完整报告/长表/复述文件内容。"
    }
  },
  "skills": {
    "paths": [
      "${KILO_CONFIG_DIR}/.kilo/skills",
      "${HOME}/.agents/skills"
    ]
  },
  "permission": {
    "bash": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "npx",
        "gitnexus",
        "mcp"
      ],
      "enabled": false,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp"
      ],
      "enabled": false,
      "timeout": 120000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://huixin.nat100.top/v1",
        "timeout": 600000,
        "chunkTimeout": 600000,
        "maxRetries": 2
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k3": {
          "name": "kimi-k3",
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    }
  }
}
