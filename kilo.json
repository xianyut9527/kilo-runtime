{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/deepseek-v4-pro",
  "small_model": "hx/deepseek-v4-flash",
  "default_agent": "coderAgent",
  "instructions": [
    "./.kilo/instructions/core.md",
    "./.kilo/instructions/workflow.md",
    "./.kilo/instructions/reflection.md"
  ],
  "snapshot": true,
  "compaction": {
    "auto": true,
    "threshold_percent": 85,
    "tail_turns": 5,
    "preserve_recent_tokens": 12000,
    "prune": true
  },
  "agent": {
    "coderAgent": {
      "mode": "primary",
      "model": "hx/deepseek-v4-pro",
      "temperature": 0,
      "prompt": "使用coderAgent模式。"
    },
    "engineer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-pro",
      "temperature": 0
    },
    "architect": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2
    },
    "checker": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0
    },
    "pre-checker": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.1",
      "temperature": 0.1
    },
    "review-security": {
      "mode": "subagent",
      "model": "hx/glm-5.1",
      "temperature": 0.1
    },
    "review-architecture": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.1
    },
    "review-simplification": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0
    },
    "executor-A": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-pro",
      "temperature": 0
    },
    "executor-B": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.1
    },
    "executor-C": {
      "mode": "subagent",
      "model": "hx/glm-5.1",
      "temperature": 0
    },
    "synthesizer": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.1
    },
    "ensemble": {
      "mode": "all",
      "model": "hx/kimi-k2.6",
      "temperature": 0.1
    }
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": ["npx", "gitnexus", "mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp"],
      "enabled": true,
      "timeout": 120000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://xianyu1.natapp4.cc/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true
        },
        "glm-5.1": {
          "name": "glm-5.1",
          "reasoning": true
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true
        },
        "qwen3.7-max": {
          "name": "qwen3.7-max",
          "reasoning": true
        },
        "qwen3.7-plus": {
          "name": "qwen3.7-plus",
          "reasoning": true
        }
      }
    },
    "dp": {
      "name": "dp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true
        }
      }
    }
  }
}
