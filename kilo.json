{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/MiniMax-M3",
  "small_model": "hx/MiniMax-M2.7-highspeed",
  "default_agent": "coderAgent",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "threshold_percent": 85,
    "tail_turns": 12,
    "preserve_recent_tokens": 60000,
    "prune": false
  },
  "skills": {
    "external_dirs": []
  },
  "agent": {
    "coderAgent": {
      "mode": "primary",
      "model": "hx/kimi-k2.7-code",
      "temperature": 0.1,
      "prompt": "coderAgent（主控 agent）。锚点：意图判定、定级、pre-checker、engineer、checker、fixer、reviewer、feedback-collector、skills-writer、experience-ranker、compaction。"
    },
    "engineer": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "engineer"
    },
    "architect": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.3,
      "prompt": "architect"
    },
    "checker": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "checker"
    },
    "pre-checker": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "pre-checker"
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "fixer"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "reviewer"
    },
    "executor-A": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "executor-A"
    },
    "executor-B": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "executor-B"
    },
    "executor-C": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "executor-C"
    },
    "synthesizer": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "synthesizer"
    },
    "skills-writer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "skills-writer"
    },
    "feedback-collector": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "feedback-collector"
    },
    "experience-ranker": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "experience-ranker"
    },
    "ensemble": {
      "mode": "all",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "ensemble"
    }
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "npx",
        "gitnexus",
        "mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp"
      ],
      "enabled": false,
      "timeout": 120000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://huixin.nat100.top/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "qwen3.7-max": {
          "name": "qwen3.7-max",
          "reasoning": true
        },
        "qwen3.7-plus": {
          "name": "qwen3.7-plus",
          "reasoning": true
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    }
  }
}
