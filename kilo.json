{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "coderAgent",
  "instructions": [
    "./.kilo/instructions/core.md",
    "./.kilo/instructions/workflow.md",
    "./.kilo/instructions/reflection.md"
  ],
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": false
  },
  "agent": {
    "coderAgent": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.3
    },
    "engineer": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.2
    },
    "architect": {
      "model": "hscp/kimi-k2.6",
      "temperature": 0.2
    },
    "checker": {
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.0
    },
    "fixer": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.1
    },
    "reviewer": {
      "model": "hscp/glm-5.1",
      "temperature": 0.1
    },
    "review-security": {
      "model": "hscp/glm-5.1",
      "temperature": 0.1
    },
    "review-architecture": {
      "model": "hscp/kimi-k2.6",
      "temperature": 0.1
    },
    "review-simplification": {
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.2
    },
    "executor-A": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.2
    },
    "executor-B": {
      "model": "hscp/kimi-k2.6",
      "temperature": 0.3
    },
    "executor-C": {
      "model": "hscp/glm-5.1",
      "temperature": 0.0
    },
    "synthesizer": {
      "model": "hscp/kimi-k2.6",
      "temperature": 0.1
    },
    "ensemble": {
      "model": "hscp/kimi-k2.6",
      "temperature": 0.1
    },
    "coder": { "disable": true }
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": ["npx", "gitnexus", "mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp"],
      "enabled": true,
      "timeout": 120000
    }
  },
  "provider": {
    "hsyq": {
      "name": "hsyq",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/plan/v3"
      },
      "models": {
        "glm-5.1": {
          "name": "glm-5.1",
          "reasoning": true
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true
        },
        "doubao-seed-2.0-mini": {
          "name": "doubao-seed-2.0-mini"
        }
      }
    },
    "aly": {
      "name": "aly",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://coding.dashscope.aliyuncs.com/v1"
      },
      "models": {
        "glm-5": {
          "name": "glm-5",
          "reasoning": true
        },
        "kimi-k2.5": {
          "name": "kimi-k2.5",
          "reasoning": true
        }
      }
    },
    "hscp": {
      "name": "hscp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/coding/v3"
      },
      "models": {
        "glm-5.1": {
          "name": "glm-5.1",
          "reasoning": true
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true
        },
        "doubao-seed-2.0-code": {
          "name": "doubao-seed-2.0-code",
          "reasoning": true
        },
        "doubao-seed-2.0-lite": {
          "name": "doubao-seed-2.0-lite"
        }
      }
    },
    "ollama": {
      "name": "ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ollama.com/v1"
      },
      "models": {
        "glm-5.1": {
          "name": "glm-5.1",
          "reasoning": true
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true
        }
      }
    }
  }
}
