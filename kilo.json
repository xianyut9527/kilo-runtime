{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/glm-5.3-flash",
  "small_model": "hx/minimax-m3",
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://xianyu1.natapp4.cc/v1",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "minimax-m3": {
          "name": "minimax-m3",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 32768
          }
        }
      }
    }
  }
}
