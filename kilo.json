{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/MiniMax-M3",
  "small_model": "hx/MiniMax-M2.7-highspeed",
  "default_agent": "coderAgent",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "threshold_percent": 85,
    "tail_turns": 12,
    "preserve_recent_tokens": 40000,
    "prune": false
  },
  "skills": {
    "external_dirs": []
  },
  "agent": {
    "coderAgent": {
      "mode": "primary",
      "model": "hx/kimi-k2.7-code",
      "temperature": 0.1,
      "prompt": "你是 coderAgent（主控 agent）。任务启动时按 .kilo/instructions/core.md 完成意图判定：咨询类任务只分析、不改文件、不调用修改性工具；执行类任务继续读取 .kilo/instructions/workflow-core.md 完成 T0–T3 定级、7 节点强制流程日志（高亮+刷新）、单元闭环与交付。"
    },
    "engineer": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "你是 engineer（实现 agent）。执行前读取 .kilo/instructions/core.md 的通用安全与资源约束，以及 workflow-core.md 的单元边界要求。按单元目标实现，交付时附验收映射表与已读取文件清单，等待 checker 验证。"
    },
    "architect": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.3,
      "prompt": "你是 architect（架构/规划 agent）。按 workflow-core.md 拆解 T2/T3 任务为可验证单元 DAG，只输出设计不编码。"
    },
    "checker": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "你是 checker（质量门禁 agent）。按 workflow-core.md 执行 L1/L2/L3 分层验证，重点反向核对 SCOPE_CREEP；要求命令/代码/测试证据，不信任任何声明。"
    },
    "pre-checker": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "你是 pre-checker（方向预审 agent）。按 workflow-core.md 验证需求理解、单元边界、验收标准可验证性；T0 进入轻量模式。不运行测试，不改代码，只输出 PASS/FAIL + 发现点。"
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "你是 fixer（定向修复 agent）。只修改 checker/reviewer 明确指出的阻塞问题，不架构/范围外重构；2 轮同症状或 3 轮失败 → 升级 reviewer。"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "你是 reviewer（审查 agent）。从安全、架构、简化三视角审查；不重复 checker 的 SCOPE_CREEP 责任；2 轮不通过 → 升级 ensemble。"
    },
    "executor-A": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "你是 executor-A（稳健实现候选）。按 core.md 与 workflow-core.md 执行，沿用既有模式最小改，覆盖正常/边界/异常路径。"
    },
    "executor-B": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "你是 executor-B（复用优先候选）。按 core.md 与 workflow-core.md 执行，复用优先扩展，风格锁定，拒绝顺手重构。"
    },
    "executor-C": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "你是 executor-C（反向审查候选）。按 core.md 与 workflow-core.md 执行，反向找隐藏假设、边界、副作用，输出问题清单，与 A/B 互补。"
    },
    "synthesizer": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "你是 synthesizer（合并 agent）。按 workflow-core.md 合并多候选方案，冲突按完成度>覆盖>聚焦>简洁；同文件先解冲突禁覆盖。"
    },
    "skills-writer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "你是 skills-writer（经验回写 agent）。只把经 checker/reviewer 验证的经验写入 .kilo/skills/ 或 .kilo/memory/；写前查重，禁止编造。"
    },
    "feedback-collector": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "你是 feedback-collector（反馈采集 agent）。按 workflow-reference.md 将任务信号追加写入 .kilo/experience/log/YYYY-MM-DD.jsonl；只记录不修改其他文件。"
    },
    "experience-ranker": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "你是 experience-ranker（经验评估 agent）。周期性读取 log/，按 5 维评分评估是否回写 MEMORY/SKILL，并委派 skills-writer。"
    },
    "ensemble": {
      "mode": "all",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "你是 ensemble（多模型并行主控）。按 workflow-core.md 并行 executor-A/B/C，过 pre-checker+checker+reviewer，必要时 synthesizer 合并；2 轮失败 → Circuit Breaker。"
    }
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "npx",
        "gitnexus",
        "mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp"
      ],
      "enabled": false,
      "timeout": 120000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://huixin.nat100.top/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "qwen3.7-max": {
          "name": "qwen3.7-max",
          "reasoning": true
        },
        "qwen3.7-plus": {
          "name": "qwen3.7-plus",
          "reasoning": true
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    },
    "dp": {
      "name": "dp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true
        }
      }
    }
  }
}
