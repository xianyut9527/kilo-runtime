{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/glm-5.2",
  "small_model": "hx/MiniMax-M2.7-highspeed",
  "default_agent": "conductor",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 25,
    "preserve_recent_tokens": 160000,
    "reserved": 16384
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "agent": {
    "conductor": {
      "mode": "primary",
      "model": "hx/glm-5.2"
    },
    "multiModel": {
      "mode": "primary",
      "model": "hx/glm-5.2"
    },
    "synthesizer-fusion": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-pro"
    },
    "planner": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-pro"
    },
    "plan-reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2"
    },
    "coder": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-pro"
    },
    "coder-a": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6"
    },
    "coder-b": {
      "mode": "subagent",
      "model": "hx/glm-5.2"
    },
    "coder-c": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-pro"
    },
    "verifier": {
      "mode": "subagent",
      "model": "hx/glm-5.2"
    },
    "reverse-auditor": {
      "mode": "subagent",
      "model": "hx/glm-5.2"
    },
    "side-checker": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-pro"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2"
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-pro"
    }
  },
  "skills": {
    "paths": ["${KILO_CONFIG_DIR}/.kilo/skills", "${HOME}/.agents/skills"]
  },
  "permission": {
    "bash": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": ["npx", "gitnexus", "mcp"],
      "enabled": false,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp"],
      "enabled": false,
      "timeout": 120000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://huixin.nat100.top/v1",
        "timeout": 600000,
        "chunkTimeout": 180000,
        "maxRetries": 2
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k3": {
          "name": "kimi-k3",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    }
  }
}
