{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/kimi-k2.7-code",
  "default_agent": "coderAgent",
  "compaction": {
    "auto": true
  },
  "agent": {
    "coderAgent": {
      "mode": "primary",
      "model": "hx/kimi-k2.7-code",
      "temperature": 0.1,
      "prompt": "coderAgent（主控 agent）。锚点：意图判定、定级、pre-checker、engineer、checker、fixer、reviewer、compaction。T0/T1 任务跳过 ensemble，直接用 single engineer。"
    },
    "engineer": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "engineer"
    },
    "architect": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.1,
      "prompt": "architect"
    },
    "checker": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "checker"
    },
    "pre-checker": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "pre-checker"
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "fixer"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "reviewer"
    },
    "executor-A": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "executor-A"
    },
    "executor-B": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "executor-B"
    },
    "executor-C": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "executor-C"
    },
    "synthesizer": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "synthesizer"
    },
    "ensemble": {
      "mode": "all",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "ensemble"
    }
  },
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "npx",
        "gitnexus",
        "mcp"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://huixin.nat100.top/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "qwen3.7-max": {
          "name": "qwen3.7-max",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "qwen3.7-plus": {
          "name": "qwen3.7-plus",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    }
  }
}
