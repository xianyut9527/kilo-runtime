{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/kimi-k2.7-code",
  "small_model": "hx/MiniMax-M2.7-highspeed",
  "default_agent": "coderAgent",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "threshold_percent": 65,
    "tail_turns": 25,
    "preserve_recent_tokens": 120000,
    "prune": false
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "agent": {
    "coderAgent": {
      "mode": "primary",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "coderAgent（主控 agent）。锚点：意图判定、定级、pre-checker、engineer、checker、fixer、reviewer、compaction。T0/T1 任务跳过 ensemble，直接用 single engineer。"
    },
    "engineer": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "参见 .kilo/agent/engineer.md"
    },
    "architect": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "参见 .kilo/agent/architect.md"
    },
    "checker": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "参见 .kilo/agent/checker.md"
    },
    "pre-checker": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "参见 .kilo/agent/pre-checker.md"
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "temperature": 0,
      "prompt": "参见 .kilo/agent/fixer.md"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "参见 .kilo/agent/reviewer.md"
    },
    "executor-A": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "executor-A"
    },
    "executor-B": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "temperature": 0,
      "prompt": "executor-B"
    },
    "executor-C": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "temperature": 0,
      "prompt": "executor-C"
    },
    "synthesizer": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "temperature": 0,
      "prompt": "synthesizer"
    },
    "ensemble": {
      "mode": "all",
      "model": "hx/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "ensemble"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": ["npx", "gitnexus", "mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp"],
      "enabled": true,
      "timeout": 120000
    },
    "ddg-search": {
      "type": "remote",
      "url": "https://mcp.duckduckgo.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "mcp-sqlite", "C:\\Users\\hzhb\\.config\\kilo\\memory\\memory.db"],
      "enabled": true,
      "timeout": 10000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://huixin.nat100.top/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "strengths": ["快速推理", "代码审查", "模式识别"],
            "weaknesses": ["过度自信", "复杂架构设计", "长上下文保持"],
            "best_for": ["checker", "fixer", "快速分析"],
            "avoid_for": ["architect", "复杂根因分析", "多文件协调"],
            "speed": "fast",
            "cost": "low"
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "strengths": ["深度推理", "复杂逻辑", "数学/算法"],
            "weaknesses": ["速度较慢", "输出冗长"],
            "best_for": ["T3 根因分析", "算法实现", "安全审查"],
            "avoid_for": ["快速迭代", "简单任务"],
            "speed": "medium",
            "cost": "medium"
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "strengths": ["结构化输出", "安全审查", "中文理解"],
            "weaknesses": ["简化建议不足", "架构深度有限"],
            "best_for": ["reviewer", "安全审查", "合规检查"],
            "avoid_for": ["复杂重构", "创新设计"],
            "speed": "medium",
            "cost": "medium"
          }
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "strengths": ["长上下文", "代码生成", "多文件协调", "图像理解"],
            "weaknesses": ["极端复杂推理", "数学竞赛级问题"],
            "best_for": ["coderAgent", "engineer", "synthesizer", "architect"],
            "avoid_for": ["纯数学证明", "极端性能优化"],
            "speed": "medium",
            "cost": "medium"
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "strengths": ["顶级代码能力", "长上下文", "复杂重构", "图像理解"],
            "weaknesses": ["资源消耗高", "速度较慢"],
            "best_for": ["T3 核心逻辑", "复杂重构", "关键架构设计"],
            "avoid_for": ["简单机械任务", "高并发短任务"],
            "speed": "slow",
            "cost": "high"
          }
        },
        "qwen3.7-max": {
          "name": "qwen3.7-max",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "strengths": ["综合能力均衡", "中文理解强", "工具调用"],
            "weaknesses": ["代码深度不如 kimi", "架构设计中等"],
            "best_for": ["通用任务", "中文文档", "工具链集成"],
            "avoid_for": ["极端复杂代码", "安全敏感核心逻辑"],
            "speed": "medium",
            "cost": "medium"
          }
        },
        "qwen3.7-plus": {
          "name": "qwen3.7-plus",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "strengths": ["图像理解", "多模态", "中文场景"],
            "weaknesses": ["纯代码能力弱于 kimi", "长上下文保持一般"],
            "best_for": ["UI 相关任务", "前端组件", "图文分析"],
            "avoid_for": ["后端核心逻辑", "复杂算法"],
            "speed": "medium",
            "cost": "medium"
          }
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "strengths": ["创意生成", "多模态", "对话流畅"],
            "weaknesses": ["代码严谨性不足", "结构化输出不稳定"],
            "best_for": ["executor-C（ensemble 多样性）", "创意探索", "文档起草"],
            "avoid_for": ["checker", "fixer", "关键代码生成"],
            "speed": "medium",
            "cost": "medium"
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "strengths": ["极速响应", "成本低", "简单任务"],
            "weaknesses": ["复杂推理弱", "代码质量不稳定", "长上下文差"],
            "best_for": ["small_model", "T0 机械任务", "搜索确认", "读取文件"],
            "avoid_for": ["T2+", "checker", "fixer", "reviewer", "关键代码"],
            "speed": "very_fast",
            "cost": "very_low"
          }
        }
      }
    }
  }
}
