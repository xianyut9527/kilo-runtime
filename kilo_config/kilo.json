{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "hx/MiniMax-M3",
  "small_model": "hx/MiniMax-M2.7-highspeed",
  "default_agent": "coderAgent",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "threshold_percent": 65,
    "tail_turns": 25,
    "preserve_recent_tokens": 60000,
    "prune": true
  },
  "commit_message": {
    "prompt": "根据 staged diff 生成中文 commit message。\n\n要求：\n1. 先分析 diff 内容，识别：修改了哪些文件、什么函数/逻辑、数据流如何变化\n2. type(scope): 标题 ≤50字，无句号\n3. 正文用 bullet 列出具体变更点（每点说明改了什么文件和什么逻辑）\n4. 如果修复了 bug，说明修复了什么问题；如果新增功能，说明新增了什么能力\n5. 仅输出 commit message，不要解释\n\ntype: feat/fix/refactor/perf/test/docs/chore/style\nscope: 核心模块名（如 auth, api, ui, db）"
  },
  "agent": {
    "coderAgent": {
      "mode": "primary",
      "model": "hx/MiniMax-M3",
      "variant": "thinking",
      "temperature": 0.3,
      "prompt": "锚点：意图判定→定级(T0-T3)→流程日志；T1+ pre-checker→engineer→checker→fixer 闭环；T2+ 加 reviewer；compaction 后保留锚点；M1-M8 记忆节点；SCOPE_CREEP 双向核对；[MISSING_MEMORY_WRITE] 阻塞；详见 agent/coderAgent.md。"
    },
    "engineer": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "variant": "thinking",
      "temperature": 0
    },
    "architect": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "variant": "high",
      "temperature": 0.3
    },
    "checker": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "variant": "max",
      "temperature": 0
    },
    "pre-checker": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "variant": "high",
      "temperature": 0
    },
    "fixer": {
      "mode": "subagent",
      "model": "hx/deepseek-v4-flash",
      "variant": "max",
      "temperature": 0
    },
    "reviewer": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "variant": "max",
      "temperature": 0.2
    },
    "executor-A": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "variant": "high",
      "temperature": 0
    },
    "executor-B": {
      "mode": "subagent",
      "model": "hx/glm-5.2",
      "variant": "max",
      "temperature": 0
    },
    "executor-C": {
      "mode": "subagent",
      "model": "hx/MiniMax-M3",
      "variant": "thinking",
      "temperature": 0
    },
    "synthesizer": {
      "mode": "subagent",
      "model": "hx/kimi-k2.6",
      "variant": "high",
      "temperature": 0.2
    },
    "ensemble": {
      "mode": "all",
      "model": "hx/MiniMax-M3",
      "variant": "thinking",
      "temperature": 0.2
    }
  },
  "skills": {
    "external_dirs": [
      "${KILO_CONFIG_DIR}/.kilo/skills",
      "${HOME}/.agents/skills"
    ]
  },
  "permission": {
    "bash": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 8000
    },
    "gitnexus": {
      "type": "local",
      "command": ["npx", "gitnexus", "mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp"],
      "enabled": true,
      "timeout": 120000
    },
    "ddg-search": {
      "type": "remote",
      "url": "https://mcp.duckduckgo.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "sqlite": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "${HOME}/.config/kilo-data/memory.db"
      ],
      "enabled": true,
      "timeout": 10000
    }
  },
  "provider": {
    "hx": {
      "name": "hx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://huixin.nat100.top/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "qwen3.7-max": {
          "name": "qwen3.7-max",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "qwen3.7-plus": {
          "name": "qwen3.7-plus",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "kimi-k3": {
          "name": "kimi-k3",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    }
  }
}
